# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=n5hnlyba
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Production example: https://your-domain.vercel.app/studio
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3000/studio

# Studio allowlist (comma-separated emails). Invite the person in Sanity Manage first,
# then add them here and redeploy. Unlisted Editor accounts cannot use Studio.
# admin = full dashboard | news | projects | staff | pages | communications (news + projects)
NEXT_PUBLIC_SANITY_ADMIN_EMAILS=ayonbarrie4@gmail.com
NEXT_PUBLIC_SANITY_NEWS_EMAILS=
NEXT_PUBLIC_SANITY_PROJECTS_EMAILS=
NEXT_PUBLIC_SANITY_STAFF_EMAILS=
NEXT_PUBLIC_SANITY_PAGES_EMAILS=codewithbah@gmail.com
NEXT_PUBLIC_SANITY_COMMS_EMAILS=
# Legacy alias for communications (News + News Letters + Projects)
NEXT_PUBLIC_SANITY_NEWS_EDITOR_EMAILS=usifumbarrie3360@gmail.com

# Site (use your real Vercel URL in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — never expose to the browser / never commit real values
# Optional Viewer token for draft preview
SANITY_API_READ_TOKEN=
# Random string for /api/revalidate?secret=... (Sanity webhook)
SANITY_REVALIDATE_SECRET=
# Local scripts only (seed/import) — DO NOT add this to Vercel
SANITY_API_WRITE_TOKEN=

# Contact form
CONTACT_FORM_TO=info@madam-sl.org
RESEND_API_KEY=